<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nova IPTV core: Xtream API, models, storage. No user interface, so it can be tested on its own. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Nova.Core</RootNamespace>
    <AssemblyName>Nova.Core</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
  </ItemGroup>

  <!-- The film database key for the age filter: given by the build (TMDB_KEY secret), never written in the code. -->
  <ItemGroup Condition="'$(TmdbKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TmdbKey</_Parameter1>
      <_Parameter2>$(TmdbKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <InternalsVisibleTo Include="Nova.Core.Tests" />
  </ItemGroup>

</Project>
