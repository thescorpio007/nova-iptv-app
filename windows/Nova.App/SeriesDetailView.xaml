<UserControl x:Class="Nova.App.SeriesDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nova.App">
    <Grid Background="{StaticResource Bg}" ClipToBounds="True">
        <Image x:Name="Backdrop" local:Img.Width="1280" Stretch="UniformToFill" Opacity="0.28" VerticalAlignment="Top"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#900B0E12" Offset="0"/>
                    <GradientStop Color="#F00B0E12" Offset="0.45"/>
                    <GradientStop Color="#FF0B0E12" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="40,22,40,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="BackBtn" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="-10,0,0,12" Click="OnBack">
                <TextBlock Text="←  Back" Foreground="{StaticResource SubText}" FontSize="15"/>
            </Button>

            <!-- Header -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="170" Height="255" CornerRadius="10" Background="#1D2229" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="PosterTitle" Foreground="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="12"/>
                        <Image x:Name="Poster" local:Img.Width="240" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="28,0,0,0" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Meta" FontSize="14.5" Foreground="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="RatingRow" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="Stars" FontSize="20" Foreground="{StaticResource StarBrush}"/>
                        <TextBlock x:Name="RatingText" FontSize="14.5" Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="Plot" FontSize="15" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,0" MaxHeight="88" TextTrimming="WordEllipsis"/>
                    <TextBlock x:Name="CastLine" Style="{StaticResource Hint}" FontSize="13.5" Margin="0,8,0,0" MaxHeight="40" TextTrimming="WordEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="PlayBtn" Style="{StaticResource AccentButton}" Padding="22,9" FontSize="15" Click="OnPlayFirst" IsEnabled="False">
                            <TextBlock x:Name="PlayText" Text="▶  Play"/>
                        </Button>
                        <Button x:Name="EpDlBtn" Style="{StaticResource NovaButton}" Padding="16,9" Margin="10,0,0,0" FontSize="14.5"
                                Click="OnDownloadEpisode" Content="⬇  Episode" ToolTip="Download the selected episode (D)" IsEnabled="False"/>
                        <Button x:Name="SeasonDlBtn" Style="{StaticResource NovaButton}" Padding="16,9" Margin="10,0,0,0" FontSize="14.5"
                                Click="OnDownloadSeason" Content="⬇  Season" ToolTip="Download every episode of this season" IsEnabled="False"/>
                        <Button x:Name="FavBtn" Style="{StaticResource NovaButton}" Padding="16,9" Margin="10,0,0,0" FontSize="14.5" Click="OnFav"/>
                        <Button x:Name="TrailerBtn" Style="{StaticResource NovaButton}" Padding="16,9" Margin="10,0,0,0" FontSize="14.5"
                                Click="OnTrailer" Visibility="Collapsed" Content="Trailer"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Seasons -->
            <ListBox x:Name="Seasons" Grid.Row="2" Style="{StaticResource NovaList}" Margin="0,18,0,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSeasonChanged" PreviewKeyDown="OnSeasonKey">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Margin="6,0"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Episodes -->
            <ListBox x:Name="Episodes" Grid.Row="3" Style="{StaticResource NovaList}" Margin="0,4,0,0"
                     PreviewKeyDown="OnEpisodeKey" MouseDoubleClick="OnEpisodeDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="84">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="140" Height="78" CornerRadius="6" Background="#1D2229" ClipToBounds="True" Margin="0,0,14,0">
                                <Grid>
                                    <TextBlock Text="{Binding Number}" FontSize="20" FontWeight="Bold" Foreground="#50FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image local:Img.Width="200" local:Img.Url="{Binding Image}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="11" Height="11" Margin="8,0,4,0" VerticalAlignment="Center" Fill="{Binding DotBrush}"
                                             ToolTip="{Binding DotTip}" Visibility="{Binding DotVisibility}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Plot}" Style="{StaticResource Hint}" FontSize="13" MaxHeight="36"
                                           TextTrimming="WordEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Status" Grid.Row="3" Style="{StaticResource Hint}" FontSize="15" Margin="6,10"/>
            <TextBlock Grid.Row="3" Style="{StaticResource Hint}" FontSize="12.5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,-20"
                       Text="Enter: play  ·  W: download &amp; watch  ·  D: download  ·  ← → season"/>
        </Grid>
    </Grid>
</UserControl>
