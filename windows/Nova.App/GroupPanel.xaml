<UserControl x:Class="Nova.App.GroupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nova.App">
    <Border Background="{StaticResource Surface}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="Heading" Text="Groups" FontSize="13" Foreground="{StaticResource DimText}" Margin="16,12,12,6"/>
            <ListBox x:Name="GroupList" Grid.Row="1" Style="{StaticResource NovaList}" Margin="6,0,4,8"
                     SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown"
                     PreviewMouseLeftButtonUp="OnMouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GroupRow}">
                        <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" Foreground="{Binding Foreground}"
                                   Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" FontSize="14.5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Status" Grid.Row="1" Margin="16,8" Style="{StaticResource Hint}" FontSize="14" Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
