<Window x:Class="Nova.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova IPTV" Icon="Assets/nova.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        Width="1280" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing" Loaded="OnLoaded"
        AllowDrop="True" PreviewDragOver="OnDragOver" Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="{StaticResource Surface}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Source="Assets/nova.png" Width="30" Height="30" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Nova IPTV" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton x:Name="TabLive" GroupName="tabs" Style="{StaticResource TabButton}" Content="Live TV" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabFilms" GroupName="tabs" Style="{StaticResource TabButton}" Content="Films" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabSeries" GroupName="tabs" Style="{StaticResource TabButton}" Content="Series" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabSearch" GroupName="tabs" Style="{StaticResource TabButton}" Content="Search" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabLink" GroupName="tabs" Style="{StaticResource TabButton}" Content="Open link" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabRecent" GroupName="tabs" Style="{StaticResource TabButton}" Content="Recent" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabDownloads" GroupName="tabs" Style="{StaticResource TabButton}" Content="Downloads" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabSettings" GroupName="tabs" Style="{StaticResource TabButton}" Content="Settings" Checked="OnTabChecked"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border x:Name="VpnBadge" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="#1F2EE66B" Visibility="Collapsed"
                            ToolTip="A VPN connection is on">
                        <TextBlock Text="🔒 VPN" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="RecBadge" CornerRadius="6" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="#B3261E" Visibility="Collapsed">
                        <TextBlock x:Name="RecBadgeText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="ReloadButton" Style="{StaticResource FlatButton}" Click="OnReload" ToolTip="Download the lists again (F5)">
                        <TextBlock Text="↻  Reload" Foreground="{StaticResource SubText}"/>
                    </Button>
                    <TextBlock x:Name="Clock" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,4,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <ContentControl x:Name="TabHost" Focusable="False" IsTabStop="False"/>
            <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False" Visibility="Collapsed" Background="{StaticResource Bg}"/>

            <!-- First start: no account yet -->
            <Border x:Name="Welcome" Background="{StaticResource Bg}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Image Source="Assets/nova.png" Width="96" Height="96" Margin="0,0,0,18"/>
                    <TextBlock Text="Welcome to Nova IPTV" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Add your Xtream Codes account to see your channels, films and series."
                               Style="{StaticResource Hint}" FontSize="15" TextAlignment="Center" Margin="0,10,0,22"/>
                    <Button x:Name="WelcomeAdd" Style="{StaticResource AccentButton}" Content="Add account" HorizontalAlignment="Center"
                            Padding="26,10" FontSize="16" Click="OnWelcomeAdd" MinWidth="300"/>
                    <Button Style="{StaticResource NovaButton}" HorizontalAlignment="Center" Padding="22,9" Margin="0,10,0,0" MinWidth="300" Click="OnWelcomeRestore">
                        <StackPanel>
                            <TextBlock Text="Restore a backup" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="A .bak file from Nova (PC or box), or any web link" FontSize="12" Foreground="{StaticResource DimText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NovaButton}" HorizontalAlignment="Center" Padding="22,9" Margin="0,10,0,0" MinWidth="300" Click="OnWelcomeLink">
                        <StackPanel>
                            <TextBlock Text="Use an accounts link" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Your accounts list on OneDrive, Google Drive, Dropbox… — kept up to date every day" FontSize="12" Foreground="{StaticResource DimText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="WelcomeVersion" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <!-- The designer's signature, on every page -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" Padding="7,1"
                    Background="#66000000" CornerRadius="6" IsHitTestVisible="False">
                <TextBlock x:Name="SignatureText" FontSize="10.5" Foreground="#80FFFFFF"/>
            </Border>

            <!-- Short messages -->
            <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,42"
                    Padding="18,10" CornerRadius="10" Background="#EE262B33" BorderBrush="{StaticResource FocusGrey}" BorderThickness="1"
                    Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="700">
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="15"/>
            </Border>
        </Grid>
    </Grid>
</Window>
