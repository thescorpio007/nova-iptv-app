<UserControl x:Class="Nova.App.OpenLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="36,18,36,40" MaxWidth="900" HorizontalAlignment="Left" Width="900">
            <TextBlock Text="Open link" FontSize="22" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Hint}" FontSize="13.5" Margin="0,6,0,14"
                       Text="Play or download any video link: mp4, mkv, m3u8 (HLS), ts, or an M3U list of channels. Links opened here are not saved as accounts. You can also drag a link or a video file onto Nova, or right-click a video file → Open with Nova."/>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource NovaButton}" Content="Paste" Margin="8,0,0,0" Click="OnPaste"/>
                <Grid>
                    <TextBox x:Name="LinkBox" FontSize="16" PreviewKeyDown="OnLinkKey" TextChanged="OnLinkChanged"/>
                    <TextBlock x:Name="Placeholder" Text="Video link (http:// or https://)" Foreground="{StaticResource DimText}"
                               FontSize="15" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>

            <WrapPanel Margin="0,14,0,0">
                <Button x:Name="PlayBtn" Style="{StaticResource AccentButton}" Padding="22,9" Margin="0,0,10,8" Click="OnPlay">
                    <TextBlock Text="▶  Play"/>
                </Button>
                <Button x:Name="WatchBtn" Style="{StaticResource NovaButton}" Padding="18,9" Margin="0,0,10,8" Click="OnDownloadWatch" Content="⬇▶  Download &amp; Watch"/>
                <Button x:Name="DownloadBtn" Style="{StaticResource NovaButton}" Padding="18,9" Margin="0,0,10,8" Click="OnDownload" Content="⬇  Download"/>
                <Button x:Name="AccountBtn" Style="{StaticResource NovaButton}" Padding="18,9" Margin="0,0,10,8" Click="OnAddAccount" Content="＋  Add as account" Visibility="Collapsed"/>
                <Button x:Name="AdvancedBtn" Style="{StaticResource FlatButton}" Padding="12,9" Margin="0,0,10,8" Click="OnAdvanced" Content="Advanced ▸"/>
            </WrapPanel>

            <Border x:Name="AdvancedBox" Background="{StaticResource Surface}" CornerRadius="9" Padding="16,12" Visibility="Collapsed" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13"
                               Text="Nova already retries as a web browser by itself when a website refuses. Fill these only if it still fails: they are remembered for that website. Your IPTV servers are never affected."/>
                    <TextBlock Text="Referer — the website's address, e.g. https://site.com/" Foreground="{StaticResource SubText}" Margin="0,10,0,4"/>
                    <TextBox x:Name="RefererBox"/>
                    <TextBlock Text="User-Agent (browser name) — empty = automatic" Foreground="{StaticResource SubText}" Margin="0,10,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource NovaButton}" Content="Browser" Margin="8,0,0,0" Click="OnBrowserAgent"/>
                        <TextBox x:Name="AgentBox"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="14" Margin="0,6,0,0"/>

            <!-- An M3U list: its channels / videos -->
            <StackPanel x:Name="PlaylistBox" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock x:Name="PlaylistTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <ListBox x:Name="PlaylistList" Style="{StaticResource NovaList}" MaxHeight="420" PreviewKeyDown="OnPlaylistKey" MouseDoubleClick="OnPlaylistDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Group}" DockPanel.Dock="Right" Foreground="{StaticResource DimText}" FontSize="12.5" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <DockPanel Margin="0,22,0,6">
                <Button x:Name="DeleteAllBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Delete all" Click="OnDeleteAll"/>
                <TextBlock Text="RECENT LINKS" Foreground="{StaticResource DimText}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox x:Name="RecentList" Style="{StaticResource NovaList}" PreviewKeyDown="OnRecentKey" MouseDoubleClick="OnRecentDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Delete" Click="OnDeleteOne" Focusable="False"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource DimText}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoRecent" Style="{StaticResource Hint}" Text="Links you open appear here (Enter opens one again, Delete removes it)."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
