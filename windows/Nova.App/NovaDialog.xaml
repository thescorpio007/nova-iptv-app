<Window x:Class="Nova.App.NovaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova IPTV" Icon="Assets/nova.ico"
        Background="{StaticResource Surface}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14.5"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" PreviewKeyDown="OnKey">
    <StackPanel Margin="26,22,26,22">
        <TextBlock x:Name="Heading" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"/>
        <TextBox x:Name="Input" Margin="0,14,0,0" Visibility="Collapsed"/>
        <PasswordBox x:Name="Secret" Margin="0,14,0,0" Visibility="Collapsed" FontSize="15" Padding="8,6"
                     Background="{StaticResource SurfaceVar}" Foreground="{StaticResource TextBrush}" CaretBrush="White"
                     BorderBrush="{StaticResource FocusGrey}" BorderThickness="2"/>
        <TextBlock x:Name="Error" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <ItemsControl x:Name="Choices" Margin="0,12,0,0" Focusable="False" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource NovaButton}" Content="{Binding Label}" Tag="{Binding Index}" HorizontalContentAlignment="Left"
                            Margin="0,3" Click="OnChoice"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="NoBtn" Style="{StaticResource NovaButton}" MinWidth="110" Margin="0,0,10,0" Click="OnNo"/>
            <Button x:Name="YesBtn" Style="{StaticResource AccentButton}" MinWidth="110" Click="OnYes"/>
        </StackPanel>
    </StackPanel>
</Window>
