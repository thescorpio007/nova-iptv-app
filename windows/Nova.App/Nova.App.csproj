<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nova IPTV for Windows: WPF on .NET Framework 4.8, 32-bit (x86) so it runs on every PC
    from Windows 7 SP1 to Windows 11. Video is played by VLC (LibVLC).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Nova.App</RootNamespace>
    <AssemblyName>Nova</AssemblyName>
    <ApplicationIcon>Assets\nova.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Product>Nova IPTV</Product>
    <Company>A.Hamrouni</Company>
    <Copyright>Designed by A.Hamrouni</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Only the 32-bit VLC engine is needed. -->
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nova.Core\Nova.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\nova.png" />
    <Resource Include="Assets\nova.ico" />
  </ItemGroup>

</Project>
