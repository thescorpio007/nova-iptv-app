<UserControl x:Class="Nova.App.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nova.App"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition x:Name="SideColumn" Width="420"/>
        </Grid.ColumnDefinitions>

        <local:GroupPanel x:Name="Groups"/>

        <!-- Channels -->
        <Grid Grid.Column="1" Margin="8,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="10,12,10,6">
                <TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="{StaticResource DimText}" FontSize="13" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="GroupTitle" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ListBox x:Name="Channels" Grid.Row="1" Style="{StaticResource NovaList}" Margin="0,0,0,22"
                     PreviewKeyDown="OnChannelKeyDown" MouseDoubleClick="OnChannelDoubleClick"
                     PreviewMouseLeftButtonUp="OnChannelClick" SelectionChanged="OnChannelSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChannelRow}">
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource DimText}" FontSize="13"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Width="62" Height="36" Margin="0,0,10,0" CornerRadius="4" Background="#1D2229"
                                    Visibility="{Binding LogoVisibility}">
                                <Image local:Img.Width="96" local:Img.Url="{Binding Icon}" Stretch="Uniform" Margin="3"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AccountTag}" FontSize="11.5" Foreground="{StaticResource DimText}"
                                           Visibility="{Binding TagVisibility}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#B3261E" CornerRadius="4" Padding="5,0" Margin="6,0" VerticalAlignment="Center"
                                        Visibility="{Binding RecVisibility}">
                                    <TextBlock Text="● REC" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="▶" Foreground="{StaticResource Accent}" FontSize="13" Margin="6,0"
                                           Visibility="{Binding PlayingVisibility}"/>
                                <TextBlock Text="★" Foreground="{StaticResource FavBrush}" FontSize="15" Margin="6,0"
                                           Visibility="{Binding FavVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ListStatus" Grid.Row="1" Style="{StaticResource Hint}" FontSize="15" Margin="12,10"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Preview and programme guide -->
        <Border Grid.Column="2" Background="{StaticResource Surface}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="PreviewBox" Background="Black" CornerRadius="6" SizeChanged="OnPreviewSize" ClipToBounds="True">
                    <Grid>
                        <!-- Hidden (not Collapsed): the video surface must exist before VLC starts, or VLC opens its own window. -->
                        <vlc:VideoView x:Name="Video" Visibility="Hidden"/>
                        <StackPanel x:Name="PreviewIdle" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="34" Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PreviewHint" Text="Enter: preview here · Enter again: full screen"
                                       Foreground="#80FFFFFF" FontSize="12.5" Margin="10,4" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="2,12,2,6">
                    <TextBlock x:Name="PreviewStatus" Foreground="{StaticResource StarBrush}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,0,0,6" Visibility="Collapsed"/>
                    <TextBlock x:Name="ChName" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NowTitle" FontSize="15.5" Foreground="{StaticResource Accent}" Margin="0,8,0,0" TextWrapping="Wrap"
                               MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                    <DockPanel x:Name="NowBar" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="NowTime" DockPanel.Dock="Right" Foreground="{StaticResource DimText}" FontSize="12.5" Margin="10,0,0,0"/>
                        <ProgressBar x:Name="NowProgress" Style="{StaticResource ThinProgress}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="NowDesc" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" MaxHeight="72"
                               TextTrimming="WordEllipsis"/>
                </StackPanel>

                <ItemsControl x:Name="Upcoming" Grid.Row="2" Margin="2,4,2,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeRange}" Foreground="{StaticResource DimText}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="2,8,2,14"
                           Text="Enter: play · Double-click: full screen · F: favorite · R: record · ← groups"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
