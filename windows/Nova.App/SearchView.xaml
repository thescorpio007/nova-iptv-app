<UserControl x:Class="Nova.App.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nova.App">
    <UserControl.Resources>
        <DataTemplate x:Key="ResultTemplate">
            <Grid Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="{Binding ThumbWidth}" Height="48" CornerRadius="4" Background="#1D2229" Margin="0,0,10,0" ClipToBounds="True">
                    <Image local:Img.Width="90" local:Img.Url="{Binding Image}" Stretch="{Binding ThumbStretch}" Margin="{Binding ThumbMargin}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource DimText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="22,16,22,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="KindBtn" Style="{StaticResource NovaButton}" Click="OnKind" Margin="0,0,8,0" ToolTip="What to search"/>
                <Button x:Name="AccountBtn" Style="{StaticResource NovaButton}" Click="OnAccount" ToolTip="Which server to search"/>
            </StackPanel>
            <Grid MaxWidth="760" HorizontalAlignment="Left" Width="760">
                <TextBox x:Name="Box" FontSize="18" TextChanged="OnTextChanged" PreviewKeyDown="OnBoxKey"/>
                <TextBlock x:Name="Placeholder" Text="Search channels, films and series…" Foreground="{StaticResource DimText}"
                           FontSize="17" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>
        <TextBlock x:Name="Status" Grid.Row="1" Style="{StaticResource Hint}" FontSize="13.5" Margin="2,10,0,6"
                   Text="Type at least 2 letters. The first search downloads the full lists of every account, so it can take a moment."/>

        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChCol" Width="*"/>
                <ColumnDefinition x:Name="FilmCol" Width="*"/>
                <ColumnDefinition x:Name="SeriesCol" Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="ChTitle" Text="Channels" Style="{StaticResource SectionTitle}" Margin="8,6,0,6"/>
            <TextBlock x:Name="FilmTitle" Grid.Column="1" Text="Films" Style="{StaticResource SectionTitle}" Margin="8,6,0,6"/>
            <TextBlock x:Name="SeriesTitle" Grid.Column="2" Text="Series" Style="{StaticResource SectionTitle}" Margin="8,6,0,6"/>
            <ListBox x:Name="ChList" Grid.Row="1" Style="{StaticResource NovaList}" ItemTemplate="{StaticResource ResultTemplate}" Margin="0,0,8,0"
                     PreviewKeyDown="OnListKey" MouseDoubleClick="OnListDoubleClick"/>
            <ListBox x:Name="FilmList" Grid.Row="1" Grid.Column="1" Style="{StaticResource NovaList}" ItemTemplate="{StaticResource ResultTemplate}" Margin="4,0"
                     PreviewKeyDown="OnListKey" MouseDoubleClick="OnListDoubleClick"/>
            <ListBox x:Name="SeriesList" Grid.Row="1" Grid.Column="2" Style="{StaticResource NovaList}" ItemTemplate="{StaticResource ResultTemplate}" Margin="8,0,0,0"
                     PreviewKeyDown="OnListKey" MouseDoubleClick="OnListDoubleClick"/>
        </Grid>
    </Grid>
</UserControl>
