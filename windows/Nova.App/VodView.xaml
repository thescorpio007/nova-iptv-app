<UserControl x:Class="Nova.App.VodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nova.App">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <local:GroupPanel x:Name="Groups"/>

        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="10,12,18,4">
                <TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="{StaticResource DimText}" FontSize="13" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="GroupTitle" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Border x:Name="GridHost" Grid.Row="1" SizeChanged="OnGridSize" Margin="0,0,0,20">
                <ItemsControl x:Name="Posters" Focusable="False" PreviewKeyDown="OnGridKeyDown"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Once">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto" Padding="4,0">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PosterRow}">
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" KeyboardNavigation.DirectionalNavigation="Continue">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PosterItem}">
                                        <Button Style="{StaticResource PosterButton}" Width="{Binding TileWidth}" Click="OnPosterClick" ToolTip="{Binding Title}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Height="{Binding PosterHeight}" Background="#1D2229">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource DimText}" TextWrapping="Wrap"
                                                               TextAlignment="Center" VerticalAlignment="Center" Margin="10" FontSize="13"/>
                                                    <Image local:Img.Width="{Binding DecodeWidth}" local:Img.Url="{Binding Image}"
                                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2"
                                                            CornerRadius="5" Background="#CC000000" Visibility="{Binding RatingVisibility}">
                                                        <TextBlock Text="{Binding Rating}" Foreground="{StaticResource StarBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="5,1"
                                                            CornerRadius="5" Background="#CC000000" Visibility="{Binding FavVisibility}">
                                                        <TextBlock Text="★" Foreground="{StaticResource FavBrush}" FontSize="13"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Padding="6,2"
                                                            Background="#B0000000" Visibility="{Binding TagVisibility}">
                                                        <TextBlock Text="{Binding AccountTag}" FontSize="11" Foreground="#C0FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Title}" Visibility="{Binding TitleVisibility}" Margin="8,6,8,8"
                                                           FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock x:Name="ListStatus" Grid.Row="1" Style="{StaticResource Hint}" FontSize="15" Margin="12,10" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
