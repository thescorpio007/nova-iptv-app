<UserControl x:Class="Nova.App.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nova.App">
    <Grid Margin="24,14,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenFolderBtn" Style="{StaticResource NovaButton}" Content="Open downloads folder" Click="OnOpenFolder"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Downloads &amp; recordings" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="FolderText" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,8"
                   Text="Enter: play  ·  Space: pause / resume (or stop a recording)  ·  O: show in folder  ·  Delete: remove"/>

        <ListBox x:Name="DlList" Grid.Row="2" Style="{StaticResource NovaList}" PreviewKeyDown="OnListKey" MouseDoubleClick="OnDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DownloadRow}">
                    <Grid Height="74">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="68" CornerRadius="5" Background="#1D2229" Margin="0,0,14,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding KindIcon}" FontSize="22" Foreground="#60FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image local:Img.Width="90" local:Img.Url="{Binding Icon}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Margin="0,7,0,0" MaxWidth="520"
                                         HorizontalAlignment="Stretch" Visibility="{Binding ProgressVisibility}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource NovaButton}" Content="{Binding PauseLabel}" Visibility="{Binding PauseVisibility}"
                                    Click="OnPauseClick" Margin="0,0,8,0" Focusable="False"/>
                            <Button Style="{StaticResource NovaButton}" Content="▶ Play" Visibility="{Binding PlayVisibility}"
                                    Click="OnPlayClick" Margin="0,0,8,0" Focusable="False"/>
                            <Button Style="{StaticResource NovaButton}" Content="Folder" Click="OnFolderClick" Margin="0,0,8,0" Focusable="False"/>
                            <Button Style="{StaticResource NovaButton}" Content="Remove" Click="OnRemoveClick" Focusable="False"
                                    Visibility="{Binding RemoveVisibility}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Grid.Row="2" Style="{StaticResource Hint}" FontSize="15" Margin="4,10" TextWrapping="Wrap"
                   Text="Nothing yet. Use ⬇ Download on a film or episode page (or D in the player), and R on a live channel to record it."/>
    </Grid>
</UserControl>
