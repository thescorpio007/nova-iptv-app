<UserControl x:Class="Nova.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings in the same 7 groups as the box; two columns on a wide window (groups 1–3 left, 4–7 right). Built in code. -->
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False" PreviewKeyDown="OnScrollKey" SizeChanged="OnSize">
        <StackPanel Margin="30,10,30,48">
            <Border x:Name="LockBar" Background="{StaticResource Surface}" CornerRadius="9" Padding="16,12" Margin="0,10,0,10" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="UnlockBtn" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Unlock" Click="OnUnlock"/>
                    <TextBlock Text="🔒  Settings are locked by your parental PIN." VerticalAlignment="Center" FontSize="15"/>
                </DockPanel>
            </Border>
            <Grid x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftWidth" Width="*"/>
                    <ColumnDefinition x:Name="GapWidth" Width="24"/>
                    <ColumnDefinition x:Name="RightWidth" Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LeftCol"/>
                <StackPanel x:Name="RightCol" Grid.Column="2"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
