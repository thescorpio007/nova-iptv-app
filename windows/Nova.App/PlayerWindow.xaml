<Window x:Class="Nova.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Nova IPTV" Icon="Assets/nova.ico"
        Background="Black" Foreground="White" FontFamily="Segoe UI" FontSize="14"
        Width="1024" Height="600" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        PreviewKeyDown="OnKey" Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <vlc:VideoView x:Name="Video" Background="Black">
        <!-- Everything inside the VideoView is drawn over the video. -->
        <Grid x:Name="Overlay" Background="#01000000" MouseMove="OnMouseMove" MouseLeftButtonDown="OnMouseDown"
              MouseWheel="OnWheel" Loaded="OnOverlayLoaded">

            <!-- Top: channel / title and programme -->
            <Border x:Name="TopBar" VerticalAlignment="Top" Padding="26,18,26,30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DD000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <TextBlock x:Name="ClockText" DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubText" FontSize="14" Foreground="#B0FFFFFF" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border x:Name="LiveBadge" CornerRadius="5" Padding="8,2" Background="#CC000000" Visibility="Collapsed" Margin="0,0,8,0">
                                <TextBlock x:Name="LiveText" FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="RecBadge" CornerRadius="5" Padding="8,2" Background="#CCB3261E" Visibility="Collapsed">
                                <TextBlock x:Name="RecText" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="GuideBox" Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left">
                            <DockPanel>
                                <TextBlock x:Name="NowTime" DockPanel.Dock="Left" Foreground="#2EE66B" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBlock x:Name="NowText" FontSize="16" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ProgressBar x:Name="NowProgress" Style="{StaticResource ThinProgress}" Margin="0,6,0,6" Width="420" HorizontalAlignment="Left"/>
                            <DockPanel>
                                <TextBlock x:Name="NextTime" DockPanel.Dock="Left" Foreground="#B0FFFFFF" Margin="0,0,10,0"/>
                                <TextBlock x:Name="NextText" Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Middle: connecting / reconnecting / errors -->
            <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#C0000000"
                    CornerRadius="12" Padding="26,16" Visibility="Collapsed" MaxWidth="640">
                <TextBlock x:Name="StatusText" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <!-- Short on-screen messages (volume, audio track…) -->
            <Border x:Name="OsdBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,30,0" Background="#C0000000"
                    CornerRadius="10" Padding="16,10" Visibility="Collapsed">
                <TextBlock x:Name="OsdText" FontSize="17"/>
            </Border>

            <!-- Connection trouble while the picture plays on from the disk buffer -->
            <Border x:Name="NetBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,30,0" Background="#C0000000"
                    CornerRadius="10" Padding="14,8" Visibility="Collapsed" MaxWidth="460">
                <TextBlock x:Name="NetText" FontSize="14" TextWrapping="Wrap" Foreground="#FFD233"/>
            </Border>

            <!-- Bottom: position bar and buttons -->
            <Border x:Name="BottomBar" VerticalAlignment="Bottom" Padding="26,34,26,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#DD000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <DockPanel x:Name="SeekRow" Margin="0,0,0,10">
                        <TextBlock x:Name="PosText" DockPanel.Dock="Left" Width="70" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LenText" DockPanel.Dock="Right" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DiskText" DockPanel.Dock="Right" Foreground="#90FFFFFF" FontSize="12.5" VerticalAlignment="Center" Margin="10,0"/>
                        <Slider x:Name="Seek" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1" Margin="8,0"
                                PreviewMouseLeftButtonUp="OnSeekRelease" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="PlayPauseButton" Style="{StaticResource NovaButton}" Content="❚❚" Width="54" Click="OnPlayPause" Focusable="False"/>
                            <Button x:Name="BackButton" Style="{StaticResource NovaButton}" Content="« 10s" Margin="8,0,0,0" Click="OnBack10" Focusable="False"/>
                            <Button x:Name="FwdButton" Style="{StaticResource NovaButton}" Content="10s »" Margin="8,0,0,0" Click="OnFwd10" Focusable="False"/>
                            <Button x:Name="LiveButton" Style="{StaticResource NovaButton}" Content="Live (L)" Margin="8,0,0,0" Click="OnBackToLive" Focusable="False" Visibility="Collapsed"/>
                            <Button x:Name="RecButton" Style="{StaticResource NovaButton}" Content="● Rec (R)" Margin="8,0,0,0" Click="OnRec" Focusable="False" Visibility="Collapsed"/>
                            <Button x:Name="DownloadButton" Style="{StaticResource NovaButton}" Content="⬇ Download (D)" Margin="8,0,0,0" Click="OnDownload" Focusable="False" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource NovaButton}" Content="Audio (A)" Click="OnAudio" Focusable="False"/>
                            <Button Style="{StaticResource NovaButton}" Content="Subtitles (S)" Margin="8,0,0,0" Click="OnSubs" Focusable="False"/>
                            <Button Style="{StaticResource NovaButton}" Content="Aspect (Z)" Margin="8,0,0,0" Click="OnAspect" Focusable="False"/>
                            <Button Style="{StaticResource NovaButton}" Content="Full screen (F)" Margin="8,0,0,0" Click="OnFullScreen" Focusable="False"/>
                            <Button Style="{StaticResource NovaButton}" Content="Close (Esc)" Margin="8,0,0,0" Click="OnCloseClick" Focusable="False"/>
                        </StackPanel>
                        <TextBlock x:Name="KeysHint" Foreground="#90FFFFFF" FontSize="12.5" VerticalAlignment="Center" Margin="16,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" Padding="7,1"
                    Background="#66000000" CornerRadius="6" IsHitTestVisible="False">
                <TextBlock Text="Designed by A.H" FontSize="10.5" Foreground="#80FFFFFF"/>
            </Border>
        </Grid>
    </vlc:VideoView>
</Window>
