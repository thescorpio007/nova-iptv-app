<Window x:Class="Nova.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nova.App"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Nova IPTV" Icon="Assets/nova.ico"
        Background="Black" Foreground="White" FontFamily="Segoe UI" FontSize="14"
        Width="1024" Height="600" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        PreviewKeyDown="OnKey" Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <vlc:VideoView x:Name="Video" Background="Black">
        <!-- Everything inside the VideoView is drawn over the video. -->
        <Grid x:Name="Overlay" Background="#01000000" MouseMove="OnMouseMove" MouseLeftButtonDown="OnMouseDown"
              MouseWheel="OnWheel" Loaded="OnOverlayLoaded">

            <!-- Top: channel / title and programme -->
            <Border x:Name="TopBar" VerticalAlignment="Top" Padding="26,18,26,30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DD000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="0,0,120,0">
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" FontSize="14" Foreground="#B0FFFFFF" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border x:Name="LiveBadge" CornerRadius="5" Padding="8,2" Background="#CC000000" Visibility="Collapsed" Margin="0,0,8,0">
                            <TextBlock x:Name="LiveText" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="RecBadge" CornerRadius="5" Padding="8,2" Background="#CCB3261E" Visibility="Collapsed" Margin="0,0,8,0">
                            <TextBlock x:Name="RecText" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <Border x:Name="FavBadge" CornerRadius="5" Padding="8,2" Background="#CC000000" Visibility="Collapsed" Margin="0,0,8,0">
                            <TextBlock Text="★ Favorite" FontSize="13" Foreground="{StaticResource FavBrush}"/>
                        </Border>
                        <Border x:Name="QualityBadge" CornerRadius="5" Padding="8,2" Background="#CC000000" Visibility="Collapsed" Margin="0,0,8,0">
                            <TextBlock x:Name="QualityText" FontSize="13" FontWeight="SemiBold" Foreground="#2EE66B"/>
                        </Border>
                        <Border x:Name="BoostBadge" CornerRadius="5" Padding="8,2" Background="#CC000000" Visibility="Collapsed" Margin="0,0,8,0">
                            <TextBlock x:Name="BoostText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource StarBrush}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="GuideBox" Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left">
                        <DockPanel>
                            <TextBlock x:Name="NowTime" DockPanel.Dock="Left" Foreground="#2EE66B" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="NowText" FontSize="16" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ProgressBar x:Name="NowProgress" Style="{StaticResource ThinProgress}" Margin="0,6,0,6" Width="420" HorizontalAlignment="Left"/>
                        <DockPanel>
                            <TextBlock x:Name="NextTime" DockPanel.Dock="Left" Foreground="#B0FFFFFF" Margin="0,0,10,0"/>
                            <TextBlock x:Name="NextText" Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Clock (Settings › Display) -->
            <Border x:Name="ClockBox" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,14" Padding="10,4"
                    CornerRadius="8" Background="#AA000000" IsHitTestVisible="False">
                <TextBlock x:Name="ClockText" FontSize="16" FontWeight="Bold"/>
            </Border>

            <!-- Channel number being typed -->
            <Border x:Name="NumberBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,30,0" Padding="18,6"
                    CornerRadius="10" Background="#DD000000" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="NumberText" FontSize="36" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            </Border>

            <!-- Middle: connecting / reconnecting / errors -->
            <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#C0000000"
                    CornerRadius="12" Padding="26,16" Visibility="Collapsed" MaxWidth="640">
                <TextBlock x:Name="StatusText" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <!-- Short on-screen messages -->
            <Border x:Name="OsdBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,30,0" Background="#C0000000"
                    CornerRadius="10" Padding="16,10" Visibility="Collapsed" MaxWidth="520">
                <TextBlock x:Name="OsdText" FontSize="17" TextWrapping="Wrap"/>
            </Border>

            <!-- Connection trouble while the picture plays on from the disk buffer -->
            <Border x:Name="NetBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,30,0" Background="#C0000000"
                    CornerRadius="10" Padding="14,8" Visibility="Collapsed" MaxWidth="460">
                <TextBlock x:Name="NetText" FontSize="14" TextWrapping="Wrap" Foreground="#FFD233"/>
            </Border>

            <!-- Bottom: position bar and buttons -->
            <Border x:Name="BottomBar" VerticalAlignment="Bottom" Padding="26,34,26,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#DD000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <DockPanel x:Name="SeekRow" Margin="0,0,0,10">
                        <TextBlock x:Name="PosText" DockPanel.Dock="Left" Width="70" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LenText" DockPanel.Dock="Right" Width="70" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DiskText" DockPanel.Dock="Right" Foreground="#90FFFFFF" FontSize="12.5" VerticalAlignment="Center" Margin="10,0"/>
                        <Slider x:Name="Seek" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1" Margin="8,0"
                                PreviewMouseLeftButtonUp="OnSeekRelease" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource NovaButton}" Content="❚❚" Width="54" Click="OnPlayPause" Focusable="False" Margin="0,4,8,0"/>
                        <Button x:Name="BackButton" Style="{StaticResource NovaButton}" Content="« 10s" Click="OnBack10" Focusable="False" Margin="0,4,8,0"/>
                        <Button x:Name="FwdButton" Style="{StaticResource NovaButton}" Content="10s »" Click="OnFwd10" Focusable="False" Margin="0,4,8,0"/>
                        <Button x:Name="ListButton" Style="{StaticResource NovaButton}" Content="☰ Channels" Click="OnListButton" Focusable="False" Margin="0,4,8,0"/>
                        <Button x:Name="LiveButton" Style="{StaticResource NovaButton}" Content="Live (L)" Click="OnBackToLive" Focusable="False" Margin="0,4,8,0" Visibility="Collapsed"/>
                        <Button x:Name="RecButton" Style="{StaticResource NovaButton}" Content="● Rec (R)" Click="OnRec" Focusable="False" Margin="0,4,8,0" Visibility="Collapsed"/>
                        <Button x:Name="SimilarButton" Style="{StaticResource NovaButton}" Content="≈ Similar" Click="OnSimilar" Focusable="False" Margin="0,4,8,0" Visibility="Collapsed"
                                ToolTip="The same channel in other groups of this server (lighter versions first)"/>
                        <Button x:Name="DownloadButton" Style="{StaticResource NovaButton}" Content="⬇ Download (D)" Click="OnDownload" Focusable="False" Margin="0,4,8,0" Visibility="Collapsed"/>
                        <Button Style="{StaticResource NovaButton}" Content="CC Audio &amp; subtitles (T)" Click="OnTracks" Focusable="False" Margin="0,4,8,0"/>
                        <Button Style="{StaticResource NovaButton}" Content="Aspect (Z)" Click="OnAspect" Focusable="False" Margin="0,4,8,0"/>
                        <Button Style="{StaticResource NovaButton}" Content="🔊 Boost · ☀ Brightness" Click="OnPictureSound" Focusable="False" Margin="0,4,8,0"/>
                        <Button x:Name="ExternalButton" Style="{StaticResource NovaButton}" Content="↗ External (E)" Click="OnExternal" Focusable="False" Margin="0,4,8,0"/>
                        <Button Style="{StaticResource NovaButton}" Content="Full screen (F)" Click="OnFullScreen" Focusable="False" Margin="0,4,8,0"/>
                        <Button Style="{StaticResource NovaButton}" Content="Close (Esc)" Click="OnCloseClick" Focusable="False" Margin="0,4,8,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="KeysHint" Foreground="#90FFFFFF" FontSize="12.5" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Groups & channels list over the video (← on live TV) -->
            <Border x:Name="ListOverlay" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="640" Visibility="Collapsed"
                    Background="#E6101317">
                <Grid Margin="10,16,10,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Groups" Foreground="{StaticResource DimText}" Margin="8,0,0,6"/>
                    <TextBlock x:Name="OverlayGroupTitle" Grid.Column="1" Foreground="{StaticResource DimText}" Margin="12,0,0,6" TextTrimming="CharacterEllipsis"/>
                    <ListBox x:Name="OverlayGroups" Grid.Row="1" Style="{StaticResource NovaList}" PreviewKeyDown="OnOverlayGroupsKey"
                             SelectionChanged="OnOverlayGroupSelected" MouseLeftButtonUp="OnOverlayGroupClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="OverlayChannels" Grid.Row="1" Grid.Column="1" Style="{StaticResource NovaList}" Margin="8,0,0,0"
                             PreviewKeyDown="OnOverlayChannelsKey" MouseDoubleClick="OnOverlayChannelClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding Number}" Width="44" Foreground="{StaticResource DimText}" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Recently watched channels (B on live TV) -->
            <Border x:Name="RecentBar" VerticalAlignment="Bottom" Visibility="Collapsed" Padding="16,12" Background="#E6101317">
                <StackPanel>
                    <TextBlock Text="Recently watched  ·  ← → choose  ·  Enter play  ·  Esc close" Foreground="{StaticResource DimText}" Margin="4,0,0,8"/>
                    <ListBox x:Name="RecentList" Style="{StaticResource NovaList}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewKeyDown="OnRecentKey" MouseDoubleClick="OnRecentClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="150">
                                    <Border Height="64" Background="#1D2229" CornerRadius="5">
                                        <Image local:Img.Width="140" local:Img.Url="{Binding Icon}" Stretch="Uniform" Margin="6"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="2,6,2,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Audio, subtitles & stream info (T) -->
            <Border x:Name="TracksPanel" HorizontalAlignment="Right" Width="440" Visibility="Collapsed" Background="#F0101317">
                <ScrollViewer x:Name="TracksScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="TracksContent" Margin="18,18,18,24" PreviewKeyDown="OnTracksKey"/>
                </ScrollViewer>
            </Border>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" Padding="7,1"
                    Background="#66000000" CornerRadius="6" IsHitTestVisible="False">
                <TextBlock x:Name="Signature" FontSize="10.5" Foreground="#80FFFFFF"/>
            </Border>
        </Grid>
    </vlc:VideoView>
</Window>
