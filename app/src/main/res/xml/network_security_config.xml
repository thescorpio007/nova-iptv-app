<?xml version="1.0" encoding="utf-8"?>
<!-- Most IPTV servers use plain http:// addresses, so allow them. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
